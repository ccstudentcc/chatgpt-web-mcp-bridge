{
  "name": "chatgpt-web-mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "A safe local tool bridge for ChatGPT Web on Windows + Chrome.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @cwmb/gateway --filter @cwmb/extension --filter @cwmb/userscript dev",
    "dev:extension": "pnpm --filter @cwmb/extension dev",
    "dev:gateway": "pnpm --filter @cwmb/gateway dev",
    "dev:userscript": "pnpm --filter @cwmb/userscript dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "vitest": "^2.0.5"
  },
  "packageManager": "pnpm@9.6.0"
}
