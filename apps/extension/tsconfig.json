{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": [],
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@cwmb/result-model": ["../../packages/result-model/dist/index.d.ts"],
      "@cwmb/shared-utils": ["../../packages/shared-utils/dist/index.d.ts"],
      "@cwmb/tool-contracts": ["../../packages/tool-contracts/dist/index.d.ts"],
      "@cwmb/turn-model": ["../../packages/turn-model/dist/index.d.ts"]
    }
  },
  "include": [
    "entrypoints/**/*.ts",
    "entrypoints/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/main/types.d.ts",
    "wxt.config.ts"
  ]
}
