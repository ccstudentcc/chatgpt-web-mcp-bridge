{
  "manifest_version": 3,
  "name": "ChatGPT Web MCP Bridge",
  "version": "0.1.0",
  "description": "Run the ChatGPT Web MCP Bridge as a Chrome extension.",
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "gm-shim.js",
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}
