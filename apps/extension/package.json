{
  "name": "@cwmb/extension",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build:deps": "tsc -b tsconfig.build.json",
    "prepare:wxt": "wxt prepare",
    "dev": "pnpm run build:deps && wxt",
    "build": "pnpm run build:deps && wxt build",
    "test": "pnpm run build:deps && pnpm run prepare:wxt && vitest run",
    "lint": "pnpm run build:deps && pnpm run prepare:wxt && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cwmb/result-model": "workspace:*",
    "@cwmb/shared-utils": "workspace:*",
    "@cwmb/tool-contracts": "workspace:*",
    "@cwmb/turn-model": "workspace:*",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.4",
    "@types/node": "^20.12.12",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.4",
    "vite": "8.0.10",
    "wxt": "0.20.25"
  }
}
